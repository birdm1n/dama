# ---------------------------------------------------------------------------
# 로컬 개발: `npx supabase start` 실행 후 `npx supabase status` 에 나오는 값을 넣는다.
# 외부 유료 API 키는 필요 없다.
# 이 파일을 .env.local 로 복사해서 사용한다. (.env* 는 git에 커밋되지 않는다)
# ---------------------------------------------------------------------------

# 브라우저에 노출돼도 되는 값 (데이터 보호는 DB의 RLS가 담당)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_여기에_supabase_status의_Publishable_key

# 이메일 인증 링크 등에 쓰는 사이트 주소 (배포 시 실제 도메인)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# 서버 전용 비밀 값 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# 현재 앱 코드는 service_role 키를 쓰지 않는다. (권한 우회가 필요한 작업은 DB 함수로 처리)
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=

# DB 테스트를 실제 Supabase 로컬 DB에 대해 돌릴 때만 사용 (npm run test:db)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
